# 复制这个文件为 .env，然后填入你自己的值。
# .env 文件不要提交到 git 仓库！

# --- Interactive Brokers 连接参数 ---
# TWS 模拟账户默认端口: 7497
# IB Gateway 模拟账户默认端口: 4002
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# --- Claude / Anthropic API ---
# 在 https://console.anthropic.com/ 生成
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
